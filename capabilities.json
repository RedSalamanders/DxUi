  "consumerInterface": {
    "scripts": {
      "vcpkg-install.ps1": ["Platform", "OutputRoot"],
      "validate-build-matrix.ps1": ["Root"],
      "Tools/validate_consumer.ps1": ["DxUiRoot", "LockFile"]
    },
    "mandatoryParameters": {
      "scripts": {
        "Tools/validate_consumer.ps1": [
          "DxUiRoot",
          "LockFile"
        ]
      },
      "modules": {
        "Tools/ConsumerBuild.psm1": {
          "Get-DxUiConsumerBuildIdentity": [
            "DxUiRoot",
            "MSBuildPath",
            "Platform"
          ]
        },
        "Tools/ConsumerUpdate.psm1": {
          "Show-DxUiUpdateNotice": [
            "LockFile"
          ]
        },
        "Tools/VisualStudio.psm1": {
          "Get-DxUiDefaultToolset": [
            "Installation"
          ]
        },
        "Tools/VcpkgTriplet.psm1": {
          "Update-DxUiVcpkgOverlayTriplet": [
            "StockTripletPath",
            "Toolset",
            "OutputDirectory"
          ]
        }
      }
    },
    "powershell": {
      "scripts": {
        "vcpkg-install.ps1": ["5.1", "7"],
        "validate-build-matrix.ps1": ["7"],
        "Tools/validate_consumer.ps1": ["5.1", "7"]
      },
      "modules": {
        "Tools/ConsumerBuild.psm1": ["5.1", "7"],
        "Tools/ConsumerUpdate.psm1": ["5.1", "7"],
        "Tools/VisualStudio.psm1": ["5.1", "7"],
        "Tools/VcpkgTriplet.psm1": ["5.1", "7"]
      }
    },
    "modules": {
      "Tools/ConsumerBuild.psm1": {
        "Get-DxUiConsumerBuildIdentity": ["DxUiRoot", "MSBuildPath", "Platform", "DisableStlAnnotations"]
      },
      "Tools/ConsumerUpdate.psm1": {
        "Show-DxUiUpdateNotice": ["LockFile"]
      },
      "Tools/VisualStudio.psm1": {
        "Get-DxUiVisualStudioInstallation": [],
