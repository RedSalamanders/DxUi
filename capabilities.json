      },
      "Tools/VcpkgTriplet.psm1": {
        "Update-DxUiVcpkgOverlayTriplet": ["StockTripletPath", "Toolset", "OutputDirectory"]
      }
    },
    "msbuild": ["Build/DxUi.Consumer.props", "Build/DxUi.Consumer.targets", "Build/DxUi.AddressSanitizer.targets", "src/DxUi.vcxproj"],
    "headers": ["include/DxUi"]
