+void TestReviewCheckboxSpaceRepublishesToggleState()
+{
+    using namespace DxUi;
+    ScopedNonActivatingTestWindows nonActivating;
+    AttachedHostWindow window;
+    auto root   = std::make_unique<Panel>();
+    auto* box   = root->AddChild<Checkbox>(std::wstring(L"Option"));
+    box->SetBounds(D2D1::RectF(0.0f, 0.0f, 160.0f, 32.0f));
+    auto* other = root->AddChild<Button>(std::wstring(L"Other"));
+    other->SetBounds(D2D1::RectF(0.0f, 40.0f, 160.0f, 72.0f));
+    window.Host().SetRoot(std::move(root));
+    window.Host().SetFocusControl(box);
+    wil::com_ptr_nothrow<IRawElementProviderFragmentRoot> rootProvider;
+    rootProvider.attach(CreateWindowHostAccessibilityProvider(window.Hwnd()));
+    Require(rootProvider != nullptr, "review: root provider");
+    wil::com_ptr_nothrow<IRawElementProviderFragment> rootFragment;
+    RequireSucceeded(rootProvider.query_to(rootFragment.put()), "review: root fragment");
+    wil::com_ptr_nothrow<IToggleProvider> toggle;
+    wil::com_ptr_nothrow<IRawElementProviderFragment> child;
+    static_cast<void>(rootFragment->Navigate(NavigateDirection_FirstChild, child.put()));
+    while (child && ! toggle)
+    {
+        wil::com_ptr_nothrow<IRawElementProviderSimple> simple;
+        wil::com_ptr_nothrow<IUnknown> pattern;
+        if (SUCCEEDED(child.query_to(simple.put())) && SUCCEEDED(simple->GetPatternProvider(UIA_TogglePatternId, pattern.put())) && pattern)
+            static_cast<void>(pattern.query_to(toggle.put()));
+        wil::com_ptr_nothrow<IRawElementProviderFragment> next;
+        static_cast<void>(child->Navigate(NavigateDirection_NextSibling, next.put()));
+        child = std::move(next);
+    }
+    Require(toggle != nullptr, "review: checkbox exposes TogglePattern");
+    ToggleState beforeState = ToggleState_Indeterminate;
+    RequireSucceeded(toggle->get_ToggleState(&beforeState), "review: read toggle state before");
+    static_cast<void>(SendMessageW(window.Hwnd(), WM_KEYDOWN, VK_SPACE, 0));
+    ToggleState afterState = ToggleState_Indeterminate;
+    RequireSucceeded(toggle->get_ToggleState(&afterState), "review: read toggle state after");
+    std::cerr << "    [REVIEW] Checkbox Space: control checked=" << box->IsChecked() << " UIA ToggleState before=" << static_cast<int>(beforeState)
+              << " after=" << static_cast<int>(afterState) << '\n';
+}
