+void TestReviewAltGrLetterInTextField()
+{
+    using namespace DxUi;
+    WindowHost host;
+    auto root   = std::make_unique<Panel>();
+    auto* field = root->AddChild<TextField>(std::wstring(L"ab"));
+    field->SetBounds(D2D1::RectF(0.0f, 0.0f, 220.0f, 28.0f));
+    host.SetRoot(std::move(root));
+    host.SetFocusControl(field);
+    bool handled = false;
+    // AltGr arrives as Ctrl (synthesized) + Alt; with Ctrl down the Alt press is a WM_KEYDOWN.
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYDOWN, VK_CONTROL, 0, handled));
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYDOWN, VK_MENU, 0, handled));
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYDOWN, 'A', 0, handled));
+    static_cast<void>(host.HandleMessage(nullptr, WM_CHAR, 0x0105u, 0, handled)); // a with ogonek (Polish AltGr+A)
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYUP, 'A', 0, handled));
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYUP, VK_MENU, 0, handled));
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYUP, VK_CONTROL, 0, handled));
+    const std::wstring text(field->GetText());
+    std::cerr << "    [REVIEW] TextField \"ab\" + AltGr+A (U+0105): text length=" << text.size() << " equalsExpected=" << (text == L"ab\x0105") << " equalsOnlyChar=" << (text == L"\x0105") << '\n';
+}
