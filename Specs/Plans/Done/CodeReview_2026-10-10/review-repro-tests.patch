+// REVIEW REPRO (not for commit): remembered GetItem rows that an ordinary model shrink deletes must not block publication.
+void TestReviewGridUiaRequestedRowsDeletedByOrdinaryShrink()
+{
+    using namespace DxUi;
+    ScopedNonActivatingTestWindows nonActivating;
+    AttachedHostWindow window;
+    GridUiaPatternModel model(2000u);
+    Grid* grid = nullptr;
+    AttachGrid(window, model, grid);
+    wil::com_ptr_nothrow<IRawElementProviderFragmentRoot> root;
+    root.attach(CreateWindowHostAccessibilityProvider(window.Hwnd()));
+    Require(root != nullptr, "review: root provider");
+    wil::com_ptr_nothrow<IRawElementProviderSimple> rootSimple;
+    RequireSucceeded(root.query_to(rootSimple.put()), "review: simple root");
+    wil::com_ptr_nothrow<IUnknown> patternUnknown;
+    RequireSucceeded(rootSimple->GetPatternProvider(UIA_GridPatternId, patternUnknown.put()), "review: grid pattern");
+    wil::com_ptr_nothrow<IGridProvider> gridPattern;
+    RequireSucceeded(patternUnknown.query_to(gridPattern.put()), "review: IGridProvider");
+
+    for (int index = 0; index < 16; ++index)
+    {
+        wil::com_ptr_nothrow<IRawElementProviderSimple> requested;
+        RequireSucceeded(gridPattern->GetItem(1500 + index, 0, requested.put()), "review: remember an offscreen row");
+    }
+
+    // An ordinary refresh deletes the remembered rows from the same model assignment.
+    model.SetRowCountForReview(100u);
+    grid->NotifyDataChanged();
+    window.PumpMessages(20u);
+    int nullRoots = 0;
+    for (int attempt = 0; attempt < 10; ++attempt)
+    {
+        wil::com_ptr_nothrow<IRawElementProviderFragmentRoot> probe;
+        probe.attach(CreateWindowHostAccessibilityProvider(window.Hwnd()));
+        std::cerr << "    [REVIEW] root acquisition " << attempt << " after deletion: " << (probe ? "present" : "NULL") << '\n';
+        nullRoots += probe ? 0 : 1;
+    }
+    std::cerr << "    [REVIEW] null root acquisitions: " << nullRoots << '\n';
+
+    wil::com_ptr_nothrow<IRawElementProviderSimple> validCell;
+    const HRESULT validResult = gridPattern->GetItem(50, 0, validCell.put());
+    std::cerr << "    [REVIEW] GetItem(50,0) after deleting remembered rows: hr=0x" << std::hex << static_cast<unsigned long>(validResult) << std::dec << '\n';
+
+    wil::com_ptr_nothrow<IRawElementProviderFragmentRoot> freshRoot;
+    freshRoot.attach(CreateWindowHostAccessibilityProvider(window.Hwnd()));
+    std::cerr << "    [REVIEW] fresh root provider after deletion: " << (freshRoot ? "present" : "NULL") << '\n';
+
+    Require(SUCCEEDED(validResult) && validCell != nullptr, "review: GetItem on a valid row succeeds after remembered rows were deleted");
+    Require(freshRoot != nullptr, "review: a new client still obtains the window root after remembered rows were deleted");
+}
