+class ReviewToolbarTogglingGridDelegate final : public RecordingGridDelegate
+{
+public:
+    using RecordingGridDelegate::OnGridSelectionChanged;
+    DxUi::Button* toggleTarget = nullptr;
+    size_t focusCallbacks      = 0u;
+    void OnGridSelectionChanged(DxUi::Grid& sender) override
+    {
+        RecordingGridDelegate::OnGridSelectionChanged(sender);
+        if (toggleTarget)
+            toggleTarget->SetEnabled(! toggleTarget->IsEnabled());
+    }
+    void OnGridFocusedRowChanged(DxUi::Grid&, std::optional<uint64_t>) override
+    {
+        ++focusCallbacks;
+    }
+};
+
+struct ReviewGridFixture
+{
+    DxUi::WindowHost host;
+    MultiRowGridModel model{60u};
+    ReviewToolbarTogglingGridDelegate delegate;
+    DxUi::Grid* grid     = nullptr;
+    DxUi::Button* button = nullptr;
+    ReviewGridFixture()
+    {
+        using namespace DxUi;
+        auto root = std::make_unique<Panel>();
+        grid      = root->AddChild<Grid>();
+        grid->SetBounds(D2D1::RectF(0.0f, 0.0f, 320.0f, 240.0f));
+        grid->SetSelectionMode(GridSelectionMode::Extended);
+        grid->SetModel(&model);
+        grid->SetDelegate(&delegate);
+        button = root->AddChild<Button>(std::wstring(L"Delete"));
+        button->SetBounds(D2D1::RectF(330.0f, 0.0f, 420.0f, 30.0f));
+        host.SetRoot(std::move(root));
+        static_cast<Panel*>(host.GetRoot())->SetBounds(D2D1::RectF(0.0f, 0.0f, 440.0f, 260.0f));
+    }
+    [[nodiscard]] D2D1_POINT_2F RowPoint(size_t row) const
+    {
+        const auto rect = grid->GetVisibleRowRect(row);
+        Require(rect.has_value(), "review: row rect");
+        return D2D1::Point2F((rect->left + rect->right) * 0.5f, (rect->top + rect->bottom) * 0.5f);
+    }
+};
+
+void TestReviewGridProgrammaticSelectionSeedsKeyboard()
+{
+    ReviewGridFixture f;
+    f.grid->GetSelectionModel().SetSingle(f.model.GetStableRowId(5u));
+    f.grid->NotifyDataChanged();
+    static_cast<void>(f.grid->OnKeyDown(f.host, VK_RETURN, 0u));
+    std::cerr << "    [REVIEW] Grid row 5 selected programmatically; Enter activated row " << (f.delegate.rowActivatedCount ? static_cast<long long>(f.delegate.lastActivatedRow) : -1LL)
+              << '\n';
+    static_cast<void>(f.grid->OnKeyDown(f.host, VK_DOWN, 0u));
+    std::cerr << "    [REVIEW] then Down selected primary row " << static_cast<long long>(f.grid->GetPrimarySelectedRow().value_or(999u)) << '\n';
+}
+
+void TestReviewGridSelectionCallbackTouchingAnotherControl()
+{
+    using namespace DxUi;
+    {
+        ReviewGridFixture f;
+        f.delegate.toggleTarget = f.button;
+        const bool handled      = f.grid->OnMouseDown(f.host, f.RowPoint(3u), true, 0u);
+        std::cerr << "    [REVIEW] Grid right-click on unselected row 3 with toolbar-toggling selection callback: handled=" << handled
+                  << " selected=" << f.grid->GetSelectionModel().IsSelected(f.model.GetStableRowId(3u)) << " contextMenus=" << f.delegate.contextMenuCount
+                  << " focusCallbacks=" << f.delegate.focusCallbacks << '\n';
+    }
+    {
+        ReviewGridFixture f;
+        const bool handled = f.grid->OnMouseDown(f.host, f.RowPoint(3u), true, 0u);
+        std::cerr << "    [REVIEW] control (no toggling): handled=" << handled << " contextMenus=" << f.delegate.contextMenuCount
+                  << " focusCallbacks=" << f.delegate.focusCallbacks << '\n';
+    }
+    {
+        ReviewGridFixture f;
+        f.delegate.toggleTarget = f.button;
+        const bool added        = f.grid->RequestAddRowSelection(4u);
+        std::cerr << "    [REVIEW] Grid UIA RequestAddRowSelection(4) with toggling callback: result=" << added
+                  << " selected=" << f.grid->GetSelectionModel().IsSelected(f.model.GetStableRowId(4u)) << " focusCallbacks=" << f.delegate.focusCallbacks << '\n';
