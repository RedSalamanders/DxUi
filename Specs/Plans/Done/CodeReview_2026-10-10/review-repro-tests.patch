+void TestReviewPageHostContentTextInputAndTab()
+{
+    using namespace DxUi;
+    WindowHost host;
+    auto root     = std::make_unique<Panel>();
+    auto* before  = root->AddChild<Button>(std::wstring(L"Before"));
+    before->SetBounds(D2D1::RectF(0.0f, 0.0f, 100.0f, 30.0f));
+    auto* pageHost = root->AddChild<PageHost>();
+    pageHost->SetBounds(D2D1::RectF(0.0f, 40.0f, 300.0f, 240.0f));
+    auto page   = std::make_unique<Panel>();
+    auto* field = page->AddChild<TextField>(std::wstring(L"hello"));
+    field->SetBounds(D2D1::RectF(0.0f, 50.0f, 220.0f, 78.0f));
+    pageHost->SetPage(std::move(page));
+    auto* after = root->AddChild<Button>(std::wstring(L"After"));
+    after->SetBounds(D2D1::RectF(0.0f, 250.0f, 100.0f, 280.0f));
+    host.SetRoot(std::move(root));
+    host.SetFocusControl(field);
+    std::cerr << "    [REVIEW] PageHost field: focused=" << (host.GetFocusControl() == field) << " activeTextInput=" << host.HasActiveTextInput()
+              << " nativeSession=" << host.DebugHasActiveNativeTextInputSession() << '\n';
+    host.SetFocusControl(before);
+    bool handled = false;
+    static_cast<void>(host.HandleMessage(nullptr, WM_KEYDOWN, VK_TAB, 0, handled));
+    const Control* const afterTab = host.GetFocusControl();
+    std::cerr << "    [REVIEW] Tab from Before focuses: "
+              << (afterTab == field ? "the page field" : afterTab == after ? "After (page skipped)" : "something else") << '\n';
+
+    // Control experiment: the same field directly in a Panel.
+    WindowHost plainHost;
+    auto plainRoot   = std::make_unique<Panel>();
+    auto* plainField = plainRoot->AddChild<TextField>(std::wstring(L"hello"));
+    plainField->SetBounds(D2D1::RectF(0.0f, 0.0f, 220.0f, 28.0f));
+    plainHost.SetRoot(std::move(plainRoot));
+    plainHost.SetFocusControl(plainField);
+    std::cerr << "    [REVIEW] Panel field: activeTextInput=" << plainHost.HasActiveTextInput() << " nativeSession=" << plainHost.DebugHasActiveNativeTextInputSession() << '\n';
