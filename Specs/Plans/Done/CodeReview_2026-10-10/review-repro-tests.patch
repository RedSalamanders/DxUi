+    static_cast<void>(m.grid->OnMouseUp(m.host, m.RowPoint(2u), false, 0u));
+    static_cast<void>(m.grid->OnMouseDoubleClick(m.host, m.RowPoint(2u), false, 0u));
+    std::cerr << "    [REVIEW] Grid mouse double-click: activations=" << m.delegate.rowActivatedCount << '\n';
