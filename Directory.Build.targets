<Project>
  <Import Project="$(MSBuildThisFileDirectory)Build/DxUi.AddressSanitizer.targets" />
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <WholeProgramOptimization>true</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
    <Lib><LinkTimeCodeGeneration>true</LinkTimeCodeGeneration></Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='ASan Debug'">
    <ClCompile>
      <EnableASAN>true</EnableASAN>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <ForcedIncludeFiles>$(DxUiRepositoryRoot)src/Support/RequireAddressSanitizer.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- MSVC clears tracking state in _PrepareForClean, before BeforeClean. -->
  <Target Name="ValidateDxUiCleanOutput" BeforeTargets="_PrepareForClean" Condition="'$(DxUiGuardClean)'=='true'">
    <PropertyGroup>
      <_DxUiCleanTrackingArgument Condition="'$(TLogLocation)'!=''">-TrackingDirectory &quot;$(TLogLocation)/.&quot;</_DxUiCleanTrackingArgument>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)Tools\Assert-AnalysisOutput.ps1&quot; -OutputDirectory &quot;$(OutDir)/.&quot; -IntermediateDirectory &quot;$(IntDir)/.&quot; -Platform &quot;$(Platform)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectName &quot;$(TargetName)&quot; $(_DxUiCleanTrackingArgument)" />
  </Target>
  <Target Name="ValidateDxUiAnalysisOutput" BeforeTargets="PrepareForBuild;_PrepareForClean" Condition="'$(DxUiAnalyze)'=='true'">
    <PropertyGroup>
      <_DxUiAnalysisOutputRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).build\analysis\'))</_DxUiAnalysisOutputRoot>
      <_DxUiEvaluatedOutputRoot>$([System.IO.Path]::GetFullPath('$(DxUiOutputRoot)'))</_DxUiEvaluatedOutputRoot>
    </PropertyGroup>
    <Error Condition="'$(_DxUiEvaluatedOutputRoot)'!='$(_DxUiAnalysisOutputRoot)'" Text="DxUi code analysis requires its dedicated output directory." />
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)Tools\Assert-AnalysisOutput.ps1&quot; -OutputDirectory &quot;$(OutDir)/.&quot; -IntermediateDirectory &quot;$(IntDir)/.&quot;" />
  </Target>
  <ItemDefinitionGroup Condition="'$(DxUiAnalyze)'=='true'">
    <ClCompile>
      <EnablePREfast>true</EnablePREfast>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="ValidateDxUiBuildConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.String]::Copy('$(VCToolsVersion)').StartsWith('$(RequiredMsvcToolsVersion).'))" Text="DxUi requires MSVC build tools $(RequiredMsvcToolsVersion).x; selected $(VCToolsVersion). Install the required C++ tools and select that default toolset." />
    <Error Condition="'$(DxUiDisableStlAnnotations)'!='true' and '$(DxUiDisableStlAnnotations)'!='false'" Text="DxUiDisableStlAnnotations must be true or false and match the consumer." />
    <Error Condition="'$(Platform)'!='x64' and '$(Platform)'!='ARM64'" Text="DxUi supports x64 and ARM64." />
    <Error Condition="'$(Configuration)'!='Debug' and '$(Configuration)'!='Release' and '$(Configuration)'!='ASan Debug'" Text="DxUi supports Debug, Release and ASan Debug." />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)Build/NativeBuildPolicy.targets" />
</Project>
