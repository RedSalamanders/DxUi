---
Checks: '-*,bugprone-reserved-identifier,readability-identifier-naming'
WarningsAsErrors: 'bugprone-reserved-identifier,readability-identifier-naming'
HeaderFilterRegex: '(^|[/\\])(src|include|Tests|Samples|Tools)[/\\].*\.(h|hpp|inl)$'
ExcludeHeaderFilterRegex: '(^|[/\\])ThirdParty[/\\]'
CheckOptions:
  - key: readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: '_'
  - key: readability-identifier-naming.IgnoreMainLikeFunctions
    value: true
...
