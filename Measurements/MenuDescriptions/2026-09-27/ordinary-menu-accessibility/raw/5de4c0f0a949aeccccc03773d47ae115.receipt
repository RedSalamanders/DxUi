    const HWND foregroundBefore = GetForegroundWindow();
    const HWND nativeFocusBefore = GetFocus();
''',1)
needle='    Require(shown, "large async context menu opens");'
assert body.count(needle)==1
body=body.replace(needle,needle+'''
    if (nonactivating)
        Require(GetForegroundWindow() == foregroundBefore && GetFocus() == nativeFocusBefore,
                "large menu opening preserves foreground and native focus under the activation blocker");''',1)
needle='    Require(lastRowResolved, "large context menu resolves the last row through cached offsets");'
assert body.count(needle)==1
body=body.replace(needle,'''    if (nonactivating)
        Require(GetForegroundWindow() == foregroundBefore && GetFocus() == nativeFocusBefore,
                "large menu End navigation preserves foreground and native focus under the activation blocker");
'''+needle,1)
needle='    Require(WaitForWindowDestroyed(popupHwnd), "large context menu popup is destroyed after Escape");'
assert body.count(needle)==1
body=body.replace(needle,needle+'''
    if (nonactivating)
        Require(GetForegroundWindow() == foregroundBefore && GetFocus() == nativeFocusBefore,
                "large menu teardown preserves foreground and native focus under the activation blocker");''',1)
s=s[:a]+body+s[b:]
(o/'large-focus-invariants.patch').write_text(''.join(difflib.unified_diff(before.splitlines(True),s.splitlines(True),fromfile='a/'+f,tofile='b/'+f)),encoding='utf-8',newline='\n')
(o/'focus-invariants-manifest.json').write_text(json.dumps({'path':f,'baselineRawSha256':hashlib.sha256(data).hexdigest(),'baselineNormalizedSha256':hashlib.sha256(before.encode()).hexdigest(),'candidateNormalizedSha256':hashlib.sha256(s.encode()).hexdigest()},indent=2)+'\n')
print(hashlib.sha256((o/'large-focus-invariants.patch').read_bytes()).hexdigest())
