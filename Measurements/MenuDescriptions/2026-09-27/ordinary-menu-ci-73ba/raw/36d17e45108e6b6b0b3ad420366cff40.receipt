"""Offline audit of extracted exact-head 73ba CI native artifacts."""
import hashlib
import json
from pathlib import Path

ROOT = Path(r"C:\RedSalamander.Perf\evidence\i26-ui\menu-plain-uia-20260927\ci-73ba")
HEAD = "73ba9365726cce30299290ab9ae8afa065c4fe3d"
PROFILES = ["native-x64-Release", "native-x64-Debug", "native-x64-ASan-Debug",
            "native-ARM64-Release", "native-ARM64-Debug", "native-ARM64-ASan-Debug"]


def read(path):
    return json.loads(path.read_text(encoding="utf-8"))


def sha(path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def main():
    profiles = []
    file_manifest = []
    benchmark_hashes = set()
    for name in PROFILES:
        root = ROOT / name
        if not root.is_dir():
            raise RuntimeError(f"Missing artifact: {name}")
        for p in sorted(root.rglob("*")):
            if p.is_file():
                file_manifest.append({"path": p.relative_to(ROOT).as_posix(), "size_bytes": p.stat().st_size, "sha256": sha(p)})
        reports = root / "reports"
        suites = [read(p) for p in reports.glob("*.json") if not p.name.startswith(("Performance", "ExternalConsumer", "AddressSanitizer"))]
        suites = sorted((r for r in suites if "suite" in r), key=lambda r: r["suite"])
        perf_paths = [p for p in reports.glob("Performance-*.json") if not p.name.endswith(".comparison.json")]
        if not perf_paths:
            raise RuntimeError(f"Missing performance receipt: {name}")
        perfs = [read(p) for p in perf_paths]
        for perf in perfs:
            benchmark_hashes.add(perf["benchmarkSha256"])
        consumer_paths = sorted(reports.glob("ExternalConsumer*.json"))
        consumers = [read(p) for p in consumer_paths]
        gallery = sorted(p.relative_to(root).as_posix() for p in (root / "gallery").rglob("*") if p.is_file())
        gallery_logs = list((root / "gallery").rglob("generation.log"))
        gallery_done = len(gallery_logs) == 1 and "[DONE] Gallery" in gallery_logs[0].read_text(encoding="utf-8", errors="replace")
        sanitizer = root / "reports" / f"AddressSanitizer-{name.split('-')[1]}.json"
        profile = {
            "profile": name,
            "suite_count": len(suites),
            "suite_failures": [{"suite": s["suite"], "exit_code": s["exitCode"]} for s in suites if s["exitCode"] != 0],
            "skip_count": sum(len(s.get("skips", [])) for s in suites),
            "skips": [{"suite": s["suite"], "reason": reason} for s in suites for reason in s.get("skips", [])],
            "suite_architectures": sorted({s["nativeArchitecture"] for s in suites}),
            "suite_executable_sha256": sorted({s["sha256"] for s in suites}),
            "performance_receipts": [{"file": path.name, **{key: perf[key] for key in ("sourceCommit", "sourceDirty", "sourceFingerprint", "benchmarkSha256", "platform", "configuration", "nativeArchitecture", "roundCount", "framesPerRound")}, "scenarios": [s["name"] for s in perf["scenarios"]]} for path, perf in zip(perf_paths, perfs)],
            "consumer_receipts": [{"file": p.name, "exit_code": c["exitCode"], "commit": c["commit"], "native_architecture": c["nativeArchitecture"], "disable_stl_annotations": c["disableStlAnnotations"]} for p, c in zip(consumer_paths, consumers)],
            "gallery_files": gallery,
            "gallery_done": gallery_done,
            "sanitizer_receipt": read(sanitizer) if sanitizer.is_file() else None,
        }
        profiles.append(profile)
    if len(benchmark_hashes) != 1:
        raise RuntimeError("Benchmark fingerprints differ across CI profiles")
    issues = []
    for p in profiles:
        arm = p["profile"].startswith("native-ARM64-")
        if p["suite_failures"] or p["suite_count"] < 20:
            issues.append(f"{p['profile']}: suite failure or missing suite")
        if p["skip_count"] != (9 if arm else 0) or any(s["suite"] != "Menu" or "interactive desktop" not in s["reason"] for s in p["skips"]):
            issues.append(f"{p['profile']}: unexpected skip inventory")
        if not p["gallery_done"] or len(p["gallery_files"]) != 8:
            issues.append(f"{p['profile']}: gallery incomplete")
        if len(p["consumer_receipts"]) != (2 if "ASan" in p["profile"] else 1):
            issues.append(f"{p['profile']}: external-consumer receipt count differs")
        if any(c["exit_code"] != 0 or c["commit"] != HEAD for c in p["consumer_receipts"]):
            issues.append(f"{p['profile']}: external-consumer failure or source mismatch")
        if not p["performance_receipts"] or any(
            r["sourceCommit"] != HEAD or r["sourceDirty"] or r["roundCount"] != 5 or r["framesPerRound"] != 40 or
            r["benchmarkSha256"] != next(iter(benchmark_hashes)) for r in p["performance_receipts"]
        ):
            issues.append(f"{p['profile']}: performance provenance differs")
        if "ASan" in p["profile"]:
            s = p["sanitizer_receipt"]
            if not s or not s["detected"] or s["exitCode"] != 1:
                issues.append(f"{p['profile']}: sanitizer positive-control missing")
    audit = {"run_id": 36352406442, "head_sha": HEAD, "benchmark_sha256": next(iter(benchmark_hashes)),
             "profiles": profiles, "extracted_files": file_manifest, "qualification_issues": issues}
    (ROOT / "audit.json").write_bytes((json.dumps(audit, indent=2) + "\n").encode("utf-8"))
    rows = []
    for p in profiles:
        failure = ",".join(s["suite"] for s in p["suite_failures"]) or "none"
        rows.append(f"| {p['profile']} | {p['suite_count']} | {failure} | {p['skip_count']} | {len(p['consumer_receipts'])} | {len(p['gallery_files'])} |")
    summary = "# 73ba exact-head CI audit\n\n"
    status = read(ROOT / "run-status.json")
    native_jobs = [j for j in status["jobs"] if j["name"].startswith("native (")]
    if status["headSha"] != HEAD or len(native_jobs) != 6 or status["status"] != "completed":
        raise RuntimeError("Run identity/completion differs")
    if status["conclusion"] != "success" or any(j["conclusion"] != "success" for j in native_jobs):
        issues.append("GitHub validation or native job did not succeed")
    summary += f"Run 36352406442 at `{HEAD}` completed `{status['conclusion']}`; validation and native job conclusions are preserved in `run-status.json`. Formatting CI is separate.\n\n"
    summary += "| Profile | Suites | Failed suite | Skips | Consumer receipts | Gallery files |\n|---|---:|---|---:|---:|---:|\n" + "\n".join(rows) + "\n\n"
    summary += "Retained performance receipts, suite and external-consumer outcomes, native architectures, skips, sanitizer probes, gallery files and their extracted hashes are in `audit.json`. Performance receipts are clean exact-head source, one common benchmark fingerprint and 5×40 clean/dirty rounds where validated. ARM64 Menu's explicit interactive-desktop skips do not assert focus routing. GitHub artifact IDs/digests and job conclusions are in `run-artifacts.json` and `run-status.json`. This audit does not qualify RedSalamander's separate consumer pin.\n"
    summary += "\nQualification issues: " + ("none" if not issues else "; ".join(issues)) + ".\n"
    (ROOT / "audit.md").write_bytes(summary.encode("utf-8"))
    print("Wrote audit for", len(profiles), "profiles;", len(file_manifest), "extracted files")
    if issues:
        raise RuntimeError("CI qualification issues: " + "; ".join(issues))


if __name__ == "__main__":
    main()
