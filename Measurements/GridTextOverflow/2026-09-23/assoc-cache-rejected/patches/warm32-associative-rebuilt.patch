+void TestGridMultilineCacheReusesVisibleWorkingSet()
+{
+    using namespace DxUi;
+    // The grid borrows its model through host teardown.
+    MultiRowGridModel model(16u, true);
+    AttachedHostWindow window(WindowHost::PresentationMode::CompositionSwapChain);
+    SetWindowPos(window.Hwnd(),
+                 nullptr,
+                 0,
+                 0,
+                 static_cast<int>(std::lround(window.Host().DipsToPixels(620.0f))),
+                 static_cast<int>(std::lround(window.Host().DipsToPixels(860.0f))),
+                 SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+    window.PumpMessages();
+    auto theme          = window.Host().GetTheme();
+    theme.reducedMotion = true;
+    window.Host().SetTheme(theme);
+    auto root  = std::make_unique<Panel>();
+    auto* grid = root->AddChild<Grid>();
+    grid->SetBounds(D2D1::RectF(20.0f, 20.0f, 580.0f, 820.0f));
+    grid->SetRowHeightDip(44.0f);
+    grid->SetHeaderHeightDip(28.0f);
+    grid->SetLineClamp(2u);
+    grid->SetModel(&model);
+    const std::array<GridColumnLayoutEntry, 2> columns{{{L"name", 0u, 250.0f}, {L"summary", 1u, 250.0f}}};
+    grid->ApplyColumnLayout(columns);
+    window.Host().SetRoot(std::move(root));
+    const auto warm              = CaptureAttachedHostWindowBitmap(window, "warm visible multiline grid working set");
+    const auto previousSink      = Diagnostics::performanceSink;
+    const auto restoreSink       = wil::scope_exit([&]() noexcept { Diagnostics::performanceSink = previousSink; });
+    Diagnostics::performanceSink = &CollectGridLayoutWork;
+    gridLayoutWork               = {};
+    grid->NotifyDataChanged();
+    const auto repeated = CaptureAttachedHostWindowBitmap(window, "unchanged multiline working set after data notification");
+    std::cout << "Grid warm working set: hits=" << gridLayoutWork.hits << " misses=" << gridLayoutWork.misses
+              << " layout creations=" << gridLayoutWork.creations << '\n';
+    Require(gridLayoutWork.hits >= 32u, "unchanged visible working set must actually repaint and reuse all thirty-two multiline values");
+    Require(gridLayoutWork.misses == 0u && gridLayoutWork.creations == 0u,
+            "repainting unchanged visible cells must not reshape their text because of cache collisions");
+    Require(warm.bgraPixels == repeated.bgraPixels, "cached working-set paint preserves every rendered pixel");
+}
