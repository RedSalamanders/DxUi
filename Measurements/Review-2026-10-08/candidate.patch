+    CheckboxGridModel model(0u);
+    model.SetRows({CheckboxGridModel::Row{.label = L"Alpha"}, CheckboxGridModel::Row{.label = L"Beta"}});
+    CountingDelegate delegate;
+    WindowHost host;
+    auto root  = std::make_unique<Panel>();
