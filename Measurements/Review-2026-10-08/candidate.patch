+        bool& rejectCopies;
+        size_t& calls;
+        Callback(bool& reject, size_t& count) noexcept : rejectCopies(reject), calls(count)
+        {
+        }
+        Callback(const Callback& other) : rejectCopies(other.rejectCopies), calls(other.calls)
+        {
+            if (rejectCopies)
+            {
+                throw std::bad_alloc{};
+            }
+        }
+        void operator()(float) const
+        {
+            ++calls;
