      "reason": "Reviewed direct scenario callers plus retained-host/rendering/accessibility integration; foreground and gallery acceptance remain separate."
    }
  ],
  "toolingCommands": [
    "validate.ps1",
    "Tools/tests/Test-AsanRuntime.ps1"
  ],
  "interactiveObligations": [
    {
      "pattern": "Tests/Controls/DxUi.Tests.Menu.cpp",
      "suites": [
        "Menu"
      ],
      "reason": "menu pointer, activation and capture scenarios require the person's interactive desktop"
    },
    {
      "pattern": "Tests/Controls/DxUi.Tests.NewControls.cpp",
      "suites": [
